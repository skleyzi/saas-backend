{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "@db/(.*)": "<rootDir>/../generated/prisma/$1",
    "@common/(.*)": "<rootDir>/../src/common/$1",
    "@modules/(.*)": "<rootDir>/../src/modules/$1"
  },
  "globalSetup": "<rootDir>/setup.ts"
}